# Multi-stage build for Coolify deployment
FROM golang:1.23-alpine AS backend-builder
WORKDIR /app
RUN apk add --no-cache git ca-certificates gcc musl-dev curl
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
RUN CGO_ENABLED=1 GOOS=linux go build -a -installsuffix cgo -o server ./cmd/server

FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
RUN npm run build

FROM alpine:latest
RUN apk --no-cache add ca-certificates sqlite nginx curl bash
WORKDIR /app

# Copy backend
COPY --from=backend-builder /app/server .
COPY --from=backend-builder /app/internal/db/migrations ./internal/db/migrations
# COPY --from=backend-builder /app/internal/images ./internal/images

# Copy frontend
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy deploy script
COPY deploy-coolify.sh /app/deploy.sh
RUN chmod +x /app/deploy.sh

# Create directories
RUN mkdir -p /app/data /app/uploads

# Create startup script that runs deploy script first
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'echo "Running deployment script..."' >> /app/start.sh && \
    echo '/app/deploy.sh' >> /app/start.sh && \
    echo 'echo "Starting services..."' >> /app/start.sh && \
    echo 'nginx &' >> /app/start.sh && \
    echo './server &' >> /app/start.sh && \
    echo 'wait' >> /app/start.sh && \
    chmod +x /app/start.sh

EXPOSE 3000
CMD ["/app/start.sh"]
